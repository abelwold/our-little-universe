{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "*.local", "*-debug.log"],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9098
    },
    "functions": {
      "port": 5011
    },
    "firestore": {
      "port": 8088,
      "websocketPort": 9158
    },
    "hosting": {
      "port": 5010
    },
    "storage": {
      "port": 9198
    },
    "hub": {
      "port": 4410
    },
    "logging": {
      "port": 4510
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
